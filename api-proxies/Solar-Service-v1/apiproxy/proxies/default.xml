<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <Description/>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>CORS-Enable</Name>
      </Step>
      <Step>
        <Name>VA-VerifyKey</Name>
      </Step>
      <Step>
        <Name>SA-rateLimit</Name>
      </Step>
      <Step>
        <Name>Q-checkQuota</Name>
      </Step>
      <Step>
        <Name>OAS-checkSpec</Name>
      </Step>
      <Step>
        <Name>AM-RemoveKey</Name>
      </Step>
      <Step>
        <Name>EV-GetInputs</Name>
      </Step>
      <Step>
        <Condition>(apigee.latitude == null OR apigee.longitude == null) AND (apigee.address == null) AND (apigee.question == null)</Condition>
        <Name>RF-ValidateInputs</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
    </Response>
  </PostFlow>
  <PostClientFlow name="PostClientFlow">
    <Response>
      <Step>
        <Name>ML-sendLogsCloudLogging</Name>
      </Step>
    </Response>
  </PostClientFlow>
  <Flows>
    <Flow name="GetGeoLocation">
      <Description/>
      <Request>
        <Step>
          <Name>KVM-GetMapsKey</Name>
        </Step>
        <Step>
          <Name>SC-GetGeolocation</Name>
        </Step>
        <Step>
          <Name>EV-GetGeolocationResults</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>request.verb = "POST" AND proxy.pathsuffix MatchesPath "/data" AND apigee.address != null</Condition>
    </Flow>
    <Flow name="Question">
      <Description/>
      <Request>
        <Step>
          <Name>EV-extractPrompt</Name>
        </Step>
      </Request>
      <Response>
        <Step>
          <Name>EV-extractAnswer</Name>
        </Step>
        <Step>
          <Name>SC-anonymiseResponseDLP</Name>
        </Step>
        <Step>
          <Name>EV-extractDLPResponse</Name>
        </Step>
        <Step>
          <Name>AM-setResponseFromDLP</Name>
        </Step>
      </Response>
      <Condition>request.verb = "POST" AND proxy.pathsuffix MatchesPath "/question" </Condition>
    </Flow>
    <Flow name="unknown-path-suffix">
      <Request>
        <Step>
          <Name>RF-raiseFault404</Name>
        </Step>
      </Request>
    </Flow>
  </Flows>
  <HTTPProxyConnection>
    <BasePath>/v1/solar-service</BasePath>
    <Properties/>
    <VirtualHost>default</VirtualHost>
  </HTTPProxyConnection>
  <RouteRule name="questions">
    <Condition>(proxy.pathsuffix MatchesPath "/question") AND (request.verb != "OPTIONS")</Condition>
    <TargetEndpoint>GeminiAPI</TargetEndpoint>
  </RouteRule>
  <RouteRule name="default">
    <Condition>(request.verb != "OPTIONS")</Condition>
    <TargetEndpoint>GoogleSolarAPI</TargetEndpoint>
  </RouteRule>
  <RouteRule name="noroute"/>
</ProxyEndpoint>
