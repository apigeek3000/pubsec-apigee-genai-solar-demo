<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="VertexAgentAPI">
  <Description/>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>AM-SetTargetData</Name>
      </Step>
    </Request>
    <Response>
      <Step>
        <Name>FC-SemanticCacheResponse</Name>
        <Condition>(propertyset.vertex_config.use_cache = "true")</Condition>
      </Step>
    </Response>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
    </Response>
  </PostFlow>
  <Flows/>
  <HTTPTargetConnection>
    <Properties/>
    <URL>https://{agent.region}-dialogflow.googleapis.com/v3/projects/{organization.name}/locations/{agent.region}/agents/{agent.id}/sessions/{session-key}:detectIntent</URL>
    <Authentication>
      <GoogleAccessToken>
        <Scopes>
          <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
        </Scopes>
      </GoogleAccessToken>
    </Authentication>
  </HTTPTargetConnection>
</TargetEndpoint>
